{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flipguard://schemas/provider-execution-record-v3",
  "title": "ProviderExecutionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provider_id", "provider_commit", "runtime", "workload_id",
    "model_digest", "graph_digest", "input_id", "input_digest", "split_role",
    "key_or_context_id", "plaintext_output", "decrypted_output", "numerical_error",
    "provider_prediction", "plaintext_prediction", "decision_flip", "decision_quantity",
    "reserve_policy_status", "execution_status", "security_metadata", "compile_time_ms",
    "tuning_time_ms", "keygen_time_ms", "evaluation_time_ms", "total_time_ms",
    "raw_output_digest"
  ],
  "properties": {
    "schema_version": {"const": "flipguard_provider_execution_record_v3"},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_commit": {"type": "string", "minLength": 1},
    "runtime": {"type": "string", "minLength": 1},
    "workload_id": {"type": "string", "minLength": 1},
    "model_digest": {"type": "string", "minLength": 1},
    "graph_digest": {"type": "string", "minLength": 1},
    "input_id": {"type": "string", "minLength": 1},
    "input_digest": {"type": "string", "minLength": 1},
    "split_role": {"enum": ["CONFIGURATION_VALIDATION", "LOCKED_AUDIT", "OFFICIAL_NATIVE_DIAGNOSTIC"]},
    "key_or_context_id": {"type": "string", "minLength": 1},
    "plaintext_output": {},
    "decrypted_output": {},
    "numerical_error": {},
    "provider_prediction": {},
    "plaintext_prediction": {},
    "decision_flip": {},
    "decision_quantity": {},
    "reserve_policy_status": {"type": "string", "minLength": 1},
    "execution_status": {"type": "string", "minLength": 1},
    "security_metadata": {},
    "compile_time_ms": {},
    "tuning_time_ms": {},
    "keygen_time_ms": {},
    "evaluation_time_ms": {},
    "total_time_ms": {},
    "raw_output_digest": {"type": "string", "minLength": 1}
  }
}
