  ],
  "conditional_priority": [
    "ReSBM",
    "Orbit",
    "HEILP",
    "AutoFHE",
    "HALO",
    "SLOTHE",
    "HECO"
  ],
  "maximum_build_recovery_attempts": 3,
  "allowed_build_patches": [
    "dependency version pin",
    "non-semantic compiler compatibility",
    "path and container entrypoint repair",
    "officially documented build flag"
  ],
  "forbidden_patches": [
