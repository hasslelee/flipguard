  "native_track": {
    "raw_cross_runtime_speed_ranking_allowed": false,
    "required_fields": [
      "compile_time",
      "tuning_time",
      "plans_generated",
      "plans_executed",
      "selected_plan",
      "parameters",
      "key_generation",
      "evaluation_latency",
      "total_latency",
      "rms_error",
      "max_error",
      "outputs",
      "decision_flips",
      "security_state",
      "execution_failure"
    ]
  },
  "portable_exact_requires": [
    "graph",
    "operation_order",
    "scale_schedule",
    "rescale_modswitch_relinearization",
    "logN",
    "Q_and_P",
    "packing",
    "output_semantics"
  ],
  "common_executor": {
    "host_policy": "same host, no concurrent CKKS process",
    "fresh_keysets": 3,
    "warmup": 1,
    "measurement_passes": 6,
    "execution_order": "balanced cyclic and reverse",
    "outlier_removal": false
  },
  "bootstrapping_rule": "Do not deepen a frozen workload to manufacture bootstrapping. A new bootstrap-requiring graph requires a separately approved protocol amendment.",
  "existing_evidence_mutable": false
