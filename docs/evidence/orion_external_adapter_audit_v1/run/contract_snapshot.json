  "fail_closed_rules": [
    "do not erase RingType when translating an Orion configuration",
    "do not replace fixed-H ternary Xs with uniform ternary Xs",
    "do not infer an exact Xe distribution from a YAML file that does not serialize Xe",
    "do not assume a forked backend is byte-identical to the target backend",
    "do not execute a candidate outside the Security V2 LogN table or modulus cap"
  ],
  "claim_boundary": {
    "actual_public_source_provenance": "eligible for static evaluation",
