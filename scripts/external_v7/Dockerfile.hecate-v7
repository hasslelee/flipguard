FROM nvidia/cuda:12.2.0-devel-ubuntu22.04@sha256:c4e81887e4aa9f13b1119337323cba89601319ecb282383b879c4ba50510fd17

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cmake git gnupg libffi-dev libgmp-dev \
      libomp-dev libssl-dev libtinfo-dev libxml2-dev ninja-build \
      python3 python3-dev python3-numpy python3-pip python3-venv wget zlib1g-dev \
 && wget -qO /usr/share/keyrings/apt.llvm.org.asc https://apt.llvm.org/llvm-snapshot.gpg.key \
 && echo "deb [signed-by=/usr/share/keyrings/apt.llvm.org.asc] http://apt.llvm.org/jammy/ llvm-toolchain-jammy-18 main" \
      > /etc/apt/sources.list.d/llvm18.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      clang-18 libmlir-18-dev lld-18 llvm-18-dev mlir-18-tools \
 && rm -rf /var/lib/apt/lists/*

ENV CC=/usr/bin/clang-18
ENV CXX=/usr/bin/clang++-18
ENV PATH=/usr/lib/llvm-18/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV CMAKE_GENERATOR=Ninja

RUN clang-18 --version \
 && mlir-opt --version \
 && FileCheck --version \
 && nvcc --version

